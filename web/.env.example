# Copy to .env.local for local development, or set these in Vercel > Project > Settings > Environment Variables.

# Repository the bot lives in (public). Results are read from it without a token.
GITHUB_REPO=MisterMcFlyXXVI/Zodiac

# Optional for reading, required for the "Queue" and "Run now" buttons.
# Fine-grained personal access token, this repository only, with
#   Contents: Read and write   (to add files to hypotheses/queue/)
#   Actions:  Read and write   (to start a run)
GITHUB_TOKEN=

# Password that unlocks the buttons that change things. Anyone can view results.
ADMIN_PASSWORD=

# Optional: read results from a local folder instead of GitHub (development only).
# LOCAL_RESULTS_DIR=../live-results
